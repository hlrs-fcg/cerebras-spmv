// pe.csl
// Kernel code that runs on each PE

// Parameters passed from layout
param memcpy_params: comptime_struct;
param TOTAL_NNZ: i16;
param MAX_ROWS: i16;

// Import memcpy module for host communication
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

// ============================================================================
// Storage for SpMV data
// ============================================================================

// Row structure (CSR-style)
var row_offsets = @zeros([MAX_ROWS + 1]i32);   // Changed to i32
var num_rows = @zeros([1]i32);

// Matched pairs data
var matrix_values = @zeros([TOTAL_NNZ]f32);    // Matrix values
var vector_values = @zeros([TOTAL_NNZ]f32);    // Pre-gathered vector values

// Results
var results = @zeros([MAX_ROWS]f32);           // Output: y = A*x

// Pointers for export
var ptr_row_offsets: [*]i32 = &row_offsets;
var ptr_num_rows: [*]i32 = &num_rows;          // Changed to i32
var ptr_matrix_values: [*]f32 = &matrix_values;
var ptr_vector_values: [*]f32 = &vector_values;
const ptr_results: [*]f32 = &results;

// ============================================================================
// Compute kernel
// ============================================================================

const compute_task_id: local_task_id = @get_local_task_id(10);

task compute_spmv() void {
    // Get actual num_rows value (cast from i32 to i16 for loop)
    const n_rows = @as(i16, num_rows[0]);
    
    // Compute dot product for each row
    var r: i16 = 0;
    while (r < n_rows) : (r += 1) {
        const start = @as(i16, row_offsets[r]);
        const end = @as(i16, row_offsets[r + 1]);
        const row_len = end - start;
        
        var dot_product: f32 = 0.0;
        
        // Dot product: sum(matrix_val[i] * vector_val[i])
        var i: i16 = 0;
        while (i < row_len) : (i += 1) {
            const idx = start + i;
            dot_product += matrix_values[idx] * vector_values[idx];
        }
        
        results[r] = dot_product;
    }
    
    // CRITICAL: Unblock command stream for memcpy
    sys_mod.unblock_cmd_stream();
}

// ============================================================================
// Host-callable functions
// ============================================================================

// Function to trigger SpMV computation
fn spmv() void {
    @activate(compute_task_id);
}

// ============================================================================
// Compile-time setup
// ============================================================================

comptime {
    // Bind task to task ID
    @bind_local_task(compute_spmv, compute_task_id);
    
    // export function
    @export_symbol(spmv);

    // Export pointers to data
    @export_symbol(ptr_row_offsets, "row_offsets");
    @export_symbol(ptr_num_rows, "num_rows");
    @export_symbol(ptr_matrix_values, "matrix_values");
    @export_symbol(ptr_vector_values, "vector_values");
    @export_symbol(ptr_results, "results");
}
