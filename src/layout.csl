// layout.csl - Multi-PE grid layout
param width: i16 = 1;
param height: i16 = 1;
param TOTAL_NNZ: i16 = 50;
param MAX_ROWS: i16 = 20;
const memcpy = @import_module("<memcpy/get_params>", .{
    .width = width,
    .height = height,
});

layout {
    @set_rectangle(width, height);

    var y: i16 = 0;
    while (y < height) : (y += 1) {
        var x: i16 = 0;
        while (x < width) : (x += 1) {
            @set_tile_code(x, y, "pe.csl", .{
                .memcpy_params = memcpy.get_params(x),
                .TOTAL_NNZ = TOTAL_NNZ,
                .MAX_ROWS = MAX_ROWS,
            });
        }
    }

    @export_name("row_offsets", [*]i32, true);
    @export_name("num_rows", [*]i32, true);
    @export_name("matrix_values", [*]f32, true);
    @export_name("vector_values", [*]f32, true);
    @export_name("results", [*]f32, false);
    @export_name("spmv", fn()void);
}
