// pe.csl - SIMD optimized with DSDs (TYPE-FIXED)

param memcpy_params: comptime_struct;
param TOTAL_NNZ: i16;
param MAX_ROWS: i16;

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");

var row_offsets = @zeros([MAX_ROWS + 1]i32);
var num_rows = @zeros([1]i32);
var matrix_values = @zeros([TOTAL_NNZ]f32);
var vector_values = @zeros([TOTAL_NNZ]f32);
var results = @zeros([MAX_ROWS]f32);

var ptr_row_offsets: [*]i32 = &row_offsets;
var ptr_num_rows: [*]i32 = &num_rows;
var ptr_matrix_values: [*]f32 = &matrix_values;
var ptr_vector_values: [*]f32 = &vector_values;
const ptr_results: [*]f32 = &results;

var tscStartBuffer = @zeros([timestamp.tsc_size_words]u16);
var tscEndBuffer = @zeros([timestamp.tsc_size_words]u16);
var time_buf_u16 = @zeros([6]u16);
var ptr_time_buf_u16: [*]u16 = &time_buf_u16;

const CHUNK_SIZE: i32 = 32;
var chunk_buffer = @zeros([32]f32);

// SIMD dot product: 8× f32/cycle with @fmuls
fn dot_product_simd(start: i32, len: i32) f32 {
    var total_sum: f32 = 0.0;
    
    const num_full_chunks = len / CHUNK_SIZE;
    const remainder = len % CHUNK_SIZE;

    var chunk: i32 = 0;
    while (chunk < num_full_chunks) : (chunk += 1) {
        const offset = start + chunk * CHUNK_SIZE;

        const mat_dsd = @get_dsd(mem1d_dsd, .{
            .base_address = &matrix_values[offset],
            .extent = 32
        });
        
        const vec_dsd = @get_dsd(mem1d_dsd, .{
            .base_address = &vector_values[offset],
            .extent = 32
        });
        
        const buf_dsd = @get_dsd(mem1d_dsd, .{
            .base_address = &chunk_buffer,
            .extent = 32
        });

        @fmuls(buf_dsd, mat_dsd, vec_dsd);

        var chunk_sum: f32 = 0.0;
        var i: i32 = 0;
        while (i < 32) : (i += 1) {
            chunk_sum += chunk_buffer[i];
        }
        total_sum += chunk_sum;
    }

    if (remainder > 0) {
        const rem_start = start + num_full_chunks * CHUNK_SIZE;
        var i: i32 = 0;
        while (i < remainder) : (i += 1) {
            total_sum += matrix_values[rem_start + i] * vector_values[rem_start + i];
        }
    }
    
    return total_sum;
}

fn dot_product_scalar(start: i32, len: i32) f32 {
    var sum: f32 = 0.0;
    var i: i32 = 0;
    while (i < len) : (i += 1) {
        sum += matrix_values[start + i] * vector_values[start + i];
    }
    return sum;
}

const compute_task_id: local_task_id = @get_local_task_id(10);

task compute_spmv() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tscStartBuffer);

    const n_rows = num_rows[0];
    const SIMD_THRESHOLD: i32 = 16;

    var r: i32 = 0;
    while (r < n_rows) : (r += 1) {
        const start = row_offsets[r];
        const end = row_offsets[r + 1];
        const row_len = end - start;

        if (row_len == 0) {
            results[r] = 0.0;
        } else if (row_len < SIMD_THRESHOLD) {
            results[r] = dot_product_scalar(start, row_len);
        } else {
            results[r] = dot_product_simd(start, row_len);
        }
    }

    timestamp.get_timestamp(&tscEndBuffer);
    timestamp.disable_tsc();

    time_buf_u16[0] = tscStartBuffer[0];
    time_buf_u16[1] = tscStartBuffer[1];
    time_buf_u16[2] = tscStartBuffer[2];
    time_buf_u16[3] = tscEndBuffer[0];
    time_buf_u16[4] = tscEndBuffer[1];
    time_buf_u16[5] = tscEndBuffer[2];

    sys_mod.unblock_cmd_stream();
}

fn spmv() void {
    @activate(compute_task_id);
}

comptime {
    @bind_local_task(compute_spmv, compute_task_id);
    @export_symbol(spmv);
    @export_symbol(ptr_row_offsets, "row_offsets");
    @export_symbol(ptr_num_rows, "num_rows");
    @export_symbol(ptr_matrix_values, "matrix_values");
    @export_symbol(ptr_vector_values, "vector_values");
    @export_symbol(ptr_results, "results");
    @export_symbol(ptr_time_buf_u16, "time_buf_u16");
}
