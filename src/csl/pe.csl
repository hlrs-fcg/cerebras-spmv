// pe.csl — SpMV with permanent x, 2D tiling, east-west reduction
//
// Each PE (px, py) owns:
//   x_vec[KX]        — x slice for PE column px; loaded once, permanent across iterations
//   a_values[TOTAL_NNZ] — A tile NNZ values (H2D per SpMV)
//   a_col_ids[TOTAL_NNZ] — local column indices 0..KX-1 for x_vec lookup
//   a_row_ptr[KY+1]  — CSR row pointers over local rows 0..KY
//
// After compute, partial_y is reduced east-to-west via REDUCE_COLOR.
// Column-0 PEs write the complete y stripe to y_out; host downloads y_out
// from a 1×HEIGHT rectangle (x=0).

param memcpy_params;
param KX:        i16;  // x elements per PE column  = ceil(cols / width)
param KY:        i16;  // rows per PE row            = ceil(rows / height)
param TOTAL_NNZ: i16;  // A tile buffer size (max NNZ per PE tile at compile time)
param WIDTH:     i16;  // grid width  — used for role detection at comptime
param HEIGHT:    i16;  // grid height — unused here, kept for symmetry

const sys_mod   = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");

const my_x: i16 = @get_id(.{ .dim = .x });
const IS_RIGHT_COL: bool = (my_x == WIDTH - 1);
const IS_LEFT_COL:  bool = (my_x == 0);

// --- SRAM ---
var x_vec     = @zeros([KX]f32);
var a_values  = @zeros([TOTAL_NNZ]f32);
var a_col_ids = @zeros([TOTAL_NNZ]i32);  // i32 for 32-bit H2D compatibility
var a_row_ptr = @zeros([KY + 1]i32);
var partial_y = @zeros([KY]f32);
var y_out     = @zeros([KY]f32);         // written only by column-0 PEs

var tsc_start = @zeros([timestamp.tsc_size_words]u16);
var tsc_end   = @zeros([timestamp.tsc_size_words]u16);
var time_buf  = @zeros([3]f32);

var ptr_x_vec:     [*]f32 = &x_vec;
var ptr_a_values:  [*]f32 = &a_values;
var ptr_a_col_ids: [*]i32 = &a_col_ids;
var ptr_a_row_ptr: [*]i32 = &a_row_ptr;
const ptr_y_out:   [*]f32 = &y_out;
const ptr_time:    [*]f32 = &time_buf;

// --- Colors ---
const REDUCE_COLOR: color = @get_color(1);

// --- Task IDs ---
const compute_task_id: local_task_id = @get_local_task_id(10);
const reduce_task_id:  local_task_id = @get_local_task_id(11);

// --- Compute partial_y ---
task compute() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tsc_start);

    var r: i16 = 0;
    while (r < KY) : (r += 1) {
        var sum: f32 = 0.0;
        var i: i32 = a_row_ptr[r];
        const end: i32 = a_row_ptr[r + 1];
        while (i < end) : (i += 1) {
            sum += a_values[i] * x_vec[a_col_ids[i]];
        }
        partial_y[r] = sum;
    }

    @activate(reduce_task_id);
}

// --- East-west reduction ---
// All PEs activate this task simultaneously after compute.
// Blocking fabric receives serialize the scan from east to west automatically.
task reduce() void {
    const py_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &partial_y, .extent = KY });
    const yo_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &y_out,     .extent = KY });

    // Step 1: receive accumulated sum from eastern neighbour and add
    //         (blocks until eastern PE sends; rightmost PE has no eastern neighbour)
    if (!IS_RIGHT_COL) {
        const east_in = @get_dsd(fabin_dsd, .{
            .fabric_color = REDUCE_COLOR,
            .extent       = KY,
            .input_queue  = @get_input_queue(0),
        });
        @fadds(py_dsd, py_dsd, east_in);
    }

    // Step 2: forward accumulated partial_y west
    //         (leftmost PE has no western neighbour; it holds the complete stripe)
    if (!IS_LEFT_COL) {
        const west_out = @get_dsd(fabout_dsd, .{
            .fabric_color = REDUCE_COLOR,
            .extent       = KY,
            .output_queue = @get_output_queue(0),
        });
        @fmovs(west_out, py_dsd);
    }

    // Step 3: column-0 PEs copy the complete y stripe to y_out and record timing
    if (IS_LEFT_COL) {
        @fmovs(yo_dsd, py_dsd);

        timestamp.get_timestamp(&tsc_end);
        timestamp.disable_tsc();

        // Pack 3×u16 start + 3×u16 end into 3×f32 (SDK calculate_cycles format)
        var s = @zeros([3]u32);
        s[0] = (@as(u32, tsc_start[1]) << 16) | @as(u32, tsc_start[0]);
        s[1] = (@as(u32, tsc_end[0])   << 16) | @as(u32, tsc_start[2]);
        s[2] = (@as(u32, tsc_end[2])   << 16) | @as(u32, tsc_end[1]);
        time_buf[0] = @bitcast(f32, s[0]);
        time_buf[1] = @bitcast(f32, s[1]);
        time_buf[2] = @bitcast(f32, s[2]);
    }

    sys_mod.unblock_cmd_stream();
}

fn spmv() void {
    @activate(compute_task_id);
}

comptime {
    @bind_local_task(compute, compute_task_id);
    @bind_local_task(reduce,  reduce_task_id);

    @export_symbol(ptr_x_vec,     "x_vec");
    @export_symbol(ptr_a_values,  "a_values");
    @export_symbol(ptr_a_col_ids, "a_col_ids");
    @export_symbol(ptr_a_row_ptr, "a_row_ptr");
    @export_symbol(ptr_y_out,     "y_out");
    @export_symbol(ptr_time,      "time_buf_f32");
    @export_symbol(spmv);
}
